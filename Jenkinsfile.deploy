// Register as a separate, manually triggered Pipeline from SCM fixed to main.
pipeline {
    agent { label 'faretrack-deploy' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
    }
    environment {
        TF_IN_AUTOMATION = 'true'
        AWS_REGION = 'ap-northeast-2'
        AWS_DEFAULT_REGION = 'ap-northeast-2'
        AWS_PAGER = ''
    }
    stages {
        stage('Checkout main') {
            steps {
                deleteDir()
                checkout scm
                sh '''
                    test "$(git rev-parse HEAD)" = "$(git rev-parse refs/remotes/origin/main)"
                '''
            }
        }
        stage('Check deployment prerequisites') {
            steps {
                withCredentials([
                    string(credentialsId: 'faretrack-serpapi-api-key', variable: 'SERPAPI_API_KEY'),
                    file(credentialsId: 'faretrack-firebase-service-account', variable: 'FIREBASE_SERVICE_ACCOUNT_FILE'),
                    file(credentialsId: 'faretrack-android-google-services', variable: 'GOOGLE_SERVICES_FILE')
                ]) {
                    sh 'node infra/scripts/validate-deployment-inputs.js'
                }
                sh '''
                    command -v aws
                    command -v terraform
                    command -v javac
                    test -n "$ANDROID_HOME"
                    test -f "$ANDROID_HOME/platforms/android-36/android.jar"
                    test -x "$ANDROID_HOME/build-tools/34.0.0/aapt2"
                '''
            }
        }
        stage('Test and build') {
            steps {
                sh 'npm ci'
                sh 'npm test'
                sh 'bash backend/scripts/buildLambda.sh'
                sh 'terraform fmt -check -recursive infra'
            }
        }
        stage('Deploy dev') {
            steps {
                // AWS credentials come from the deployment agent's credential chain.
                sh 'aws sts get-caller-identity'
                withCredentials([
                    string(credentialsId: 'faretrack-google-client-id', variable: 'TF_VAR_google_client_id'),
                    string(credentialsId: 'faretrack-google-client-secret', variable: 'TF_VAR_google_client_secret'),
                    string(credentialsId: 'faretrack-kakao-client-id', variable: 'TF_VAR_kakao_client_id'),
                    string(credentialsId: 'faretrack-kakao-client-secret', variable: 'TF_VAR_kakao_client_secret'),
                    string(credentialsId: 'faretrack-ses-from-email', variable: 'TF_VAR_ses_from_email'),
                    string(credentialsId: 'faretrack-monitoring-alert-email', variable: 'TF_VAR_monitoring_alert_email')
                ]) {
                    dir('infra/terraform') {
                        sh 'terraform init -input=false -reconfigure -backend-config=environments/dev.backend.hcl'
                        sh 'terraform validate'
                        sh 'terraform plan -input=false -lock-timeout=5m -var-file=environments/dev.tfvars -out=dev.tfplan'
                        sh 'terraform apply -input=false -lock-timeout=5m dev.tfplan'
                    }
                }
            }
        }
        stage('Register application secrets') {
            steps {
                withCredentials([
                    string(credentialsId: 'faretrack-serpapi-api-key', variable: 'SERPAPI_API_KEY'),
                    file(credentialsId: 'faretrack-firebase-service-account', variable: 'FIREBASE_SERVICE_ACCOUNT_FILE')
                ]) {
                    sh 'bash infra/scripts/register-app-secrets.sh'
                }
            }
        }
        stage('Configure Android') {
            steps {
                sh 'bash infra/scripts/configure-android.sh'
                archiveArtifacts artifacts: 'dist/deployment-info.json', fingerprint: true
            }
        }
        stage('Build Android APK') {
            steps {
                withCredentials([
                    file(credentialsId: 'faretrack-android-google-services', variable: 'GOOGLE_SERVICES_FILE')
                ]) {
                    sh '''
                        set +x
                        android_config="$PWD/android/app/google-services.json"
                        cp "$GOOGLE_SERVICES_FILE" "$android_config"
                        trap 'rm -f "$android_config"' EXIT
                        cd android
                        sh ./gradlew --no-daemon assembleDebug
                    '''
                }
                archiveArtifacts artifacts: 'android/app/build/outputs/apk/debug/app-debug.apk', fingerprint: true
            }
        }
    }
    post {
        always { deleteDir() }
    }
}
